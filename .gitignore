# =============================================================
# WormAtlas — .gitignore
# Prevents secrets, local config, and generated files from
# ever being committed to the repository.
# =============================================================


# -------------------------------------------------------------
# SECRETS — NEVER COMMITTED (most critical section)
# -------------------------------------------------------------

# Environment variable files containing API keys and DB passwords
.env
.env.local
.env.dev
.env.production
*.env

# Database config with credentials
config/database.php
config/secrets.php

# Any file named with "secret" or "credentials"
*secret*
*credential*
*credentials*


# -------------------------------------------------------------
# PHP / WormAtlas APPLICATION
# -------------------------------------------------------------

# PHP dependency manager (if added later)
/vendor/
composer.lock

# PHP error logs
*.log
php_errors.log
error_log

# Uploaded files (large binary content, managed separately)
public/uploads/
content/uploads/


# -------------------------------------------------------------
# PYTHON / RAG PIPELINE
# -------------------------------------------------------------

# Virtual environments
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo

# Python egg / build artifacts
*.egg-info/
dist/
build/
.eggs/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# ChromaDB local vector database files
# (these are generated by indexing scripts, never committed)
rag_data/chromadb/
*.chroma
chroma.sqlite3


# -------------------------------------------------------------
# LOCAL DEVELOPMENT (XAMPP / macOS)
# -------------------------------------------------------------

# XAMPP local config overrides
xampp_local.conf
httpd-local.conf

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?

# macOS directory metadata
**/.DS_Store


# -------------------------------------------------------------
# VS CODE
# -------------------------------------------------------------

# VS Code workspace settings (personal, not shared)
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace

# VS Code extensions list is OK to share (committed intentionally)
# .vscode/extensions.json  ← NOT ignored

# VS Code history plugin
.history/


# -------------------------------------------------------------
# NODE / NPM (if build tools are added later)
# -------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json


# -------------------------------------------------------------
# TEMPORARY & CACHE FILES
# -------------------------------------------------------------

# OS temp files
*.tmp
*.temp
*.swp
*.swo
*~

# Cache directories
.cache/
tmp/
temp/


# -------------------------------------------------------------
# DATABASE DUMPS
# Database dumps may contain sensitive data. Export to a
# secure location outside the repo, never commit them.
# -------------------------------------------------------------

*.sql
*.sql.gz
*.dump
database_backup*
db_backup*
