# =============================================================
# WormAtlas — .env.example
# Template for environment variables. Copy this file to .env
# and fill in real values. The .env file is in .gitignore and
# will NEVER be committed to the repository.
# =============================================================

# How to set this up:
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values below with real credentials
# 3. The .env file is gitignored — it will never be committed

# --- Voyage AI (RAG embeddings) ---
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_MODEL=voyage-3.5

# --- Database (alternative to config/database.php if preferred) ---
DB_HOST=your-database-host-here
DB_NAME=your-database-name-here
DB_USER=your-database-user-here
DB_PASS=your-database-password-here

# --- Application Environment ---
# Set to "development" on local/dev, "production" on live site
APP_ENV=development
